/target

# macOS
.DS_Store

# Generated fixtures are never committed - recreate them on demand:
#   cargo run --release --bin gen_fixture
# Only hand-authored fixtures are tracked (currently ask.csv).
/fixtures/*
!/fixtures/ask.csv

# Local UI review output; keep intentional documentation images in docs/images.
/.shots/
/tools/shots/
/tools/*.png
/tools/*.log
/tools/*.err
